# 쉼표로 여러 블로그 ID를 입력할 수 있습니다.
NAVER_BLOG_IDS=your_blog_id

# 배포 후 실제 Production URL로 바꾸세요. 끝의 /는 넣지 않습니다.
SITE_ORIGIN=https://your-project.vercel.app

SITE_TITLE=네이버 블로그 링크 허브
SITE_DESCRIPTION=네이버 블로그 글을 검색엔진이 발견할 수 있도록 돕는 개인용 링크 허브입니다.

# 선택값: 증분 동기화에서 확인할 최대 글 목록 페이지 수
NAVER_INCREMENTAL_MAX_PAGES=5

# 선택값: 기존 글만 연속으로 나온 페이지가 이 횟수에 도달하면 증분 수집을 종료합니다.
NAVER_KNOWN_PAGE_STOP_COUNT=2

# 선택값: 전체 동기화에서 블로그별로 확인할 최대 페이지 수
NAVER_MAX_PAGES_PER_BLOG=1000
