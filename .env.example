# 쉼표로 여러 블로그 ID 입력 가능: myblog,my_second_blog
NAVER_BLOG_IDS=your_blog_id

# 배포 후 실제 production URL로 바꾸세요. 끝의 / 는 넣지 않습니다.
SITE_ORIGIN=https://your-project.vercel.app

SITE_TITLE=네이버 블로그 링크 허브
SITE_DESCRIPTION=네이버 블로그 글을 구글이 발견할 수 있도록 돕는 개인용 링크 허브입니다.

# 선택값: sitemap 파일 하나에 담을 URL 수
SITEMAP_CHUNK_SIZE=1000
