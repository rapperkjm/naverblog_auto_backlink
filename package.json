{
  "name": "naver-blog-backlink-hub-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run generate:sitemap && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sync:naver": "node scripts/sync-naver-posts.mjs && npm run generate:sitemap",
