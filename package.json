{
  "name": "naver-blog-backlink-hub-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sync:naver": "node scripts/sync-naver-posts.mjs && npm run generate:sitemap",
    "sync:naver:full": "node scripts/sync-naver-posts.mjs --full && npm run generate:sitemap",
    "generate:sitemap": "node scripts/generate-static-sitemap.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.69.1",
    "fast-xml-parser": "^5.9.3",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.15",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte-check": "^4.7.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.1"
  },
  "overrides": {
    "cookie": "^1.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
